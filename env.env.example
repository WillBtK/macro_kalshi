# Kalshi API credentials for the scraping pipeline.
# Copy this file to `env.env` in the repo root and fill in your values.
# `env.env` is git-ignored, so your secrets never get committed.
#
# Get credentials from the Kalshi developer portal: https://docs.kalshi.com/welcome
# (Create an API key; you receive a Key ID and download an RSA private key .pem file.)

# Your Kalshi API key ID (a UUID-looking string).
KALSHI_KEYID=your_key_id_here

# Option A (recommended locally): point to your RSA private key PEM file.
# Place the downloaded key somewhere the process can read it, e.g. key.txt in the repo root.
KALSHI_KEYFILE=key.txt

# Option B: paste the full PEM inline instead of using a file.
# python-dotenv supports multi-line quoted values. This is what the GitHub
# Action uses (injected from the KALSHI_PRIVATE_KEY secret).
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"
